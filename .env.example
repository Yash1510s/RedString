# ==============================================================================
# RedString (OSINT Investigation Copilot) - Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./osint.db

# Cache
CACHE_TTL_SECONDS=86400

# External Collector APIs (Optional)
GITHUB_TOKEN=
CERTSPOTTER_API_KEY=

# LLM Provider Configuration (Optional - fallback template works 100% without keys)
# Options: "none", "gemini", "openai", "anthropic", "ollama"
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
